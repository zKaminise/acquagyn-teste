---
import BookingLink from '../components/BookingLink.astro';
import Arrow from '../components/Arrow.astro';
import WaterLines from '../components/WaterLines.astro';
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="hero-stage">
    <div class="hero-media">
      <img
        src="/images/water-1672.webp"
        srcset="/images/water-640.webp 640w, /images/water-1280.webp 1280w, /images/water-1672.webp 1672w"
        sizes="100vw"
        width="1672"
        height="941"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
      <div class="water-light" aria-hidden="true"></div>
      <div class="hero-pool" aria-hidden="true"></div>
    </div>
    <div class="hero-shade" aria-hidden="true"></div>
    <WaterLines />
    <div class="hero-overline">
      <span>ESCOLA DE NATAÇÃO & HIDROGINÁSTICA</span>
      <span>UBERLÂNDIA, MG</span>
    </div>
    <div class="hero-copy">
      <p class="eyebrow hero-since">
        <span class="fine-line"></span> Desde 1994, em movimento.
      </p>
      <div class="hero-titles">
        <h1 id="hero-title">
          Educação e saúde <br />
          por meio da <em>água.</em>
        </h1>
        <p class="hero-next" aria-hidden="true">
          Natação que acompanha <br />
          <em>cada fase da vida.</em>
        </p>
      </div>
      <div class="hero-bottom">
        <div class="hero-actions">
          <BookingLink />
          <a class="text-link" href="#metodologia">
            Conheça nossa metodologia <Arrow />
          </a>
        </div>
        <a href="#acquagyn" class="scroll-cue">
          <span>
            ROLE PARA <br />
            MERGULHAR
          </span>
          <span class="scroll-cue-line" aria-hidden="true"></span>
        </a>
      </div>
      <button
        class="hero-film-link"
        data-open-film
        aria-haspopup="dialog"
        aria-controls="school-film"
      >
        <span class="play-disc" aria-hidden="true">
          ▶
        </span>
        <span>
          Veja a escola por dentro<span>UM OLHAR PARA A ACQUAGYN</span>
        </span>
      </button>
    </div>
    <div class="hero-frame" aria-hidden="true">
      <span>01 / 06</span>
      <span>UM NOVO COMEÇO. A CADA MERGULHO.</span>
    </div>
  </div>
</section>
