---
import { business, bookingUrl, navigation } from '../data/business';
import Arrow from './Arrow.astro';
---

<footer class="site-footer">
  <div class="footer-top">
    <a class="brand" href="#inicio" aria-label="Acquagyn — voltar ao início">
      <img src="/images/logo.png" width="160" height="80" alt="Acquagyn" loading="lazy" />
    </a>
    <p>
      Educação e saúde
      <br />
      por meio da água.
    </p>
    <a href="#inicio" class="back-top">
      Voltar ao início <span aria-hidden="true">↑</span>
    </a>
  </div>
  <div class="footer-grid">
    <div>
      <span class="eyebrow">ENCONTRE A ACQUAGYN</span>
      <address>
        {business.address}
        <br />
        {business.city}
      </address>
      <a class="text-link" href={business.maps} target="_blank" rel="noopener noreferrer">
        Ver localização <Arrow diagonal />
      </a>
    </div>
    <div>
      <span class="eyebrow">VAMOS CONVERSAR</span>
      <a class="footer-phone" href={business.phoneHref}>
        {business.phone}
      </a>
      <a href={bookingUrl()} target="_blank" rel="noopener noreferrer">
        WhatsApp ↗
      </a>
      <a href="mailto:michelampk31@gmail.com">michelampk31@gmail.com</a>
    </div>
    <div>
      <span class="eyebrow">ATENDIMENTO</span>
      <p>{business.hours}</p>
      <span class="footer-muted">Consulte horários de aulas e demais dias.</span>
      <a href={business.instagram} target="_blank" rel="noopener noreferrer">
        Instagram ↗
      </a>
      <a href="https://www.facebook.com/enacquagyn" target="_blank" rel="noopener noreferrer">
        Facebook ↗
      </a>
    </div>
  </div>
  <nav class="footer-nav" aria-label="Navegação do rodapé">
    {navigation.map(([label, href]) => (
      <a href={href}>{label}</a>
    ))}
  </nav>
  <div class="footer-wordmark" aria-hidden="true">
    <img src="/images/logo.png" width="528" height="263" alt="" loading="lazy" />
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Acquagyn. Todos os direitos reservados.</span>
    <button class="motion-toggle" data-motion-toggle aria-pressed="false">
      Reduzir movimentos
    </button>
    <span>DESDE 1994 · UBERLÂNDIA, MG</span>
  </div>
</footer>
<a
  class="floating-whatsapp"
  href={bookingUrl()}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Agendar aula experimental pelo WhatsApp"
>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M20 11.6a8 8 0 0 1-11.7 7.1L4 20l1.3-4.3A8 8 0 1 1 20 11.6Z"
      stroke="currentColor"
      stroke-width="1.5"
    />
    <path
      d="M8.5 7.5c-.6 2 .7 5.8 5.4 7.5 1 .3 2-.6 2-1.3l-2.2-1.2-1 .8a8 8 0 0 1-3-3.2l.7-.8-1-2Z"
      stroke="currentColor"
      stroke-width="1.2"
      stroke-linejoin="round"
    />
  </svg>
</a>
