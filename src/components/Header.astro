---
import { navigation } from '../data/business';
import BookingLink from './BookingLink.astro';
---

<a class="skip-link" href="#main">
  Pular para o conteúdo
</a>
<header class="site-header" id="site-header">
  <a class="brand" href="#inicio" aria-label="Acquagyn — início">
    <img src="/images/logo.png" alt="Acquagyn" width="128" height="64" />
  </a>
  <nav class="desktop-nav" aria-label="Navegação principal">
    {navigation.map(([label, href]) => (
      <a href={href}>{label}</a>
    ))}
  </nav>
  <div class="header-actions">
    <BookingLink label="Aula experimental" variant="outline" />
    <button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>
<dialog id="mobile-menu" class="mobile-menu" aria-label="Navegação mobile">
  <div class="menu-top">
    <a class="brand" href="#inicio" aria-label="Acquagyn — início">
      <img src="/images/logo.png" alt="Acquagyn" width="128" height="64" />
    </a>
    <button class="menu-close" aria-label="Fechar menu">
      Fechar <span aria-hidden="true">×</span>
    </button>
  </div>
  <nav aria-label="Navegação mobile">
    {navigation.map(([label, href], i) => (
      <a href={href}>
        <span class="menu-index" aria-hidden="true">0{i + 1}</span>
        {label}
      </a>
    ))}
  </nav>
  <BookingLink />
  <p class="menu-location">Desde 1994 · Uberlândia, MG</p>
</dialog>
