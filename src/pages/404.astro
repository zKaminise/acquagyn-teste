---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="not-found">
    <img src="/images/logo.png" alt="Acquagyn" width="160" height="80" />
    <p>404 · PÁGINA NÃO ENCONTRADA</p>
    <h1>
      Vamos voltar
      <br />
      <em>para a água?</em>
    </h1>
    <a class="button button--light" href="/">
      Conheça a nova Acquagyn →
    </a>
  </main>
</Layout>
<style>
  .not-found {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: white;
    gap: 35px;
    padding: 40px;
    text-align: center;
  }
  .not-found img {
    filter: brightness(0) invert(1);
  }
  .not-found p {
    font-size: 12px;
    letter-spacing: 0.15em;
  }
  .not-found h1 {
    font-size: clamp(40px, 7vw, 100px);
    line-height: 1.15;
    letter-spacing: -0.05em;
  }
</style>
