{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/sobre", "destination": "/#acquagyn", "permanent": true },
    { "source": "/servicos", "destination": "/#modalidades", "permanent": true },
    { "source": "/metodologia", "destination": "/#metodologia", "permanent": true },
    { "source": "/niveis", "destination": "/#metodologia", "permanent": true },
    { "source": "/mascotes", "destination": "/#metodologia", "permanent": true },
    { "source": "/contato", "destination": "/#contato", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
